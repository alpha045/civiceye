{
  "name": "civic-eye",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "if [ -d \"frontend\" ]; then (cd frontend && npm install && npm run build) && mkdir -p dist && cp -r frontend/dist/* dist/; else npm install && npm run build; fi",
    "backend:start": "npm --prefix backend run start",
    "deploy": "npx vercel --prod"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "groq-sdk": "^1.2.1",
    "image-hash": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.7",
    "openai": "^6.38.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.3"
  }
}
